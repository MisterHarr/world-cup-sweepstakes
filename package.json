{
  "name": "world-cup-sweepstakes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:app": "next dev -p 3001",
    "dev:emulator": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true next dev -p 3001",
    "dev:live-auth": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false next dev -p 3001",
    "emulators:start": "firebase emulators:start --project worldcup-sweepstake-2026 --only auth,firestore,functions --import=.local/firebase-emulators --export-on-exit=.local/firebase-emulators",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:teams-seed": "npx tsx scripts/validate-teams-seed.ts",
    "audit:fixture-teams": "npx tsx scripts/audit-fixture-team-ids.ts",
    "seed:teams:local": "npx tsx scripts/seed-local-emulator-teams.ts",
    "test:badge-feasibility": "npx tsx scripts/audit-badge-feasibility.ts",
    "test:provider:football-data": "npx tsx scripts/test-football-data-shadow-proof.ts",
    "rehearse:provider:football-data:local": "npx tsx scripts/rehearse-football-data-local.ts",
    "test:badges": "FIREBASE_EMULATOR_PROJECT=demo-worldcup-loadtest firebase emulators:exec --project demo-worldcup-loadtest --only auth,firestore,functions \"cd functions && npm run test:emulator:badges\"",
    "test:rehearsal": "FIREBASE_EMULATOR_PROJECT=demo-worldcup-loadtest firebase emulators:exec --project demo-worldcup-loadtest --only auth,firestore,functions \"cd functions && npm run test:emulator:transfer && npm run test:emulator:transfer-closed && npm run test:emulator:squad-authz && npm run test:emulator:ingest-validation && npm run test:emulator:shadow-routing && npm run test:emulator:dirty-retry\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-toast": "^1.2.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "lucide-react": "^0.562.0",
    "next": "^16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
