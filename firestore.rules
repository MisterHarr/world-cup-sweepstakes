rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Returns true when players may still submit new pot entries.
    // Checked on every potEntries create — two reads, but create is low-frequency.
    function entriesOpen() {
      let docExists = exists(/databases/$(database)/documents/settings/prizePot);
      let cfg = docExists
        ? get(/databases/$(database)/documents/settings/prizePot).data
        : {};
      let isLocked = docExists && cfg.get("potLocked", false) == true;
      let deadline = docExists ? cfg.get("entryDeadline", null) : null;
      let pastDeadline = deadline != null && request.time >= deadline;
      return !isLocked && !pastDeadline;
    }

    function isUserCreateValid(uid) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "email",
          "photoURL",
          "portfolio",
          "totalScore",
          "remainingTransfers",
          "transferPenaltyPoints",
          "isAdmin",
          "hasSeenReveal",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == uid
        && (
          !request.resource.data.keys().hasAny(["totalScore"])
          || request.resource.data.totalScore == 0
        )
        && (
          !request.resource.data.keys().hasAny(["remainingTransfers"])
          || request.resource.data.remainingTransfers == 2
        )
        && (
          !request.resource.data.keys().hasAny(["transferPenaltyPoints"])
          || request.resource.data.transferPenaltyPoints == 0
        )
        && (
          !request.resource.data.keys().hasAny(["isAdmin"])
          || request.resource.data.isAdmin == false
        )
        && (
          !request.resource.data.keys().hasAny(["hasSeenReveal"])
          || request.resource.data.hasSeenReveal == false
        )
        && (
          !request.resource.data.keys().hasAny(["portfolio"])
          || request.resource.data.portfolio.size() == 0
        );
    }

    function isUserUpdateValid(uid) {
      return (
        !request.resource.data.keys().hasAny(["uid"])
        || request.resource.data.uid == uid
      )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "displayName",
          "email",
          "photoURL",
          "hasSeenReveal",
          "updatedAt"
        ])
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(["hasSeenReveal"])
          || request.resource.data.hasSeenReveal == true
        );
    }

    // Teams: signed-in users can read teams
    match /teams/{teamId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Matches: signed-in users can read, admins can write
    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Leaderboard: signed-in users can read, admins can write
    match /leaderboard/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Shadow rehearsal data: admins only
    match /shadowMatches/{matchId} {
      allow read, write: if isAdmin();
    }

    match /shadowLeaderboard/{docId} {
      allow read, write: if isAdmin();
    }

    // Ingest health is shown on dashboard/admin pages; admins maintain it
    match /ingestHealth/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Settings (scoring, config): signed-in users can read, admins can write
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Username uniqueness locks: document ID is lowercase username, data is { uid }.
    // Created/deleted atomically by the setUsername Cloud Function (Admin SDK bypasses
    // these rules). Rules here prevent direct client manipulation.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Allow creating your doc with safe defaults only — and only before the
      // tournament begins (Mexico vs South Africa, 11 Jun 2026, 19:00 UTC).
      allow create: if signedIn()
        && request.auth.uid == uid
        && isUserCreateValid(uid)
        && request.time < timestamp.date(2026, 6, 11) + duration.time(19, 0, 0, 0);

      // Allow updates to profile fields only
      allow update: if signedIn()
        && request.auth.uid == uid
        && isUserUpdateValid(uid);

      allow delete: if false;
    }

    // Prize pot entries.
    // Players can self-declare payment (create their own pending doc).
    // Any signed-in user can read confirmed entries (for the public participants list).
    // Admins can read all entries including pending ones (for the confirmation panel).
    // All status transitions (pending→confirmed) and deletes go through Cloud Functions only.
    match /potEntries/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid              // own entry (any status)
        || isAdmin()                          // admin sees all
        || resource.data.status == "confirmed" // anyone sees confirmed entries
      );

      // Self-declaration: player creates their own pending entry.
      // Strict field validation prevents them from marking themselves as confirmed.
      // entriesOpen() enforces the server-side lock and deadline — closing
      // the pot from admin is not just a UI gate, it is rejected here too.
      allow create: if signedIn()
        && entriesOpen()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.selfDeclared == true
        && request.resource.data.keys().hasOnly([
            "uid", "displayName", "code", "selfDeclaredAt", "status", "selfDeclared"
          ]);

      // No client updates or deletes — handled by Cloud Functions via Admin SDK.
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
