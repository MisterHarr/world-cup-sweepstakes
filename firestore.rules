rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isUserCreateValid(uid) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "email",
          "photoURL",
          "portfolio",
          "totalScore",
          "remainingTransfers",
          "transferPenaltyPoints",
          "isAdmin",
          "hasSeenReveal",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == uid
        && (
          !request.resource.data.keys().hasAny(["totalScore"])
          || request.resource.data.totalScore == 0
        )
        && (
          !request.resource.data.keys().hasAny(["remainingTransfers"])
          || request.resource.data.remainingTransfers == 2
        )
        && (
          !request.resource.data.keys().hasAny(["transferPenaltyPoints"])
          || request.resource.data.transferPenaltyPoints == 0
        )
        && (
          !request.resource.data.keys().hasAny(["isAdmin"])
          || request.resource.data.isAdmin == false
        )
        && (
          !request.resource.data.keys().hasAny(["hasSeenReveal"])
          || request.resource.data.hasSeenReveal == false
        )
        && (
          !request.resource.data.keys().hasAny(["portfolio"])
          || request.resource.data.portfolio.size() == 0
        );
    }

    function isUserUpdateValid(uid) {
      return (
        !request.resource.data.keys().hasAny(["uid"])
        || request.resource.data.uid == uid
      )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "displayName",
          "email",
          "photoURL",
          "hasSeenReveal",
          "updatedAt"
        ])
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(["hasSeenReveal"])
          || request.resource.data.hasSeenReveal == true
        );
    }

    // Teams: signed-in users can read teams
    match /teams/{teamId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Matches: signed-in users can read, admins can write
    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Leaderboard: signed-in users can read, admins can write
    match /leaderboard/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Shadow rehearsal data: admins only
    match /shadowMatches/{matchId} {
      allow read, write: if isAdmin();
    }

    match /shadowLeaderboard/{docId} {
      allow read, write: if isAdmin();
    }

    // Ingest health is shown on dashboard/admin pages; admins maintain it
    match /ingestHealth/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Settings (scoring, config): signed-in users can read, admins can write
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Username uniqueness locks: document ID is lowercase username, data is { uid }.
    // Created/deleted atomically by the setUsername Cloud Function (Admin SDK bypasses
    // these rules). Rules here prevent direct client manipulation.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // Allow creating your doc with safe defaults only
      allow create: if signedIn()
        && request.auth.uid == uid
        && isUserCreateValid(uid);

      // Allow updates to profile fields only
      allow update: if signedIn()
        && request.auth.uid == uid
        && isUserUpdateValid(uid);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
